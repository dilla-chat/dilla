    {"key": "s6", "sender": "20d0ed6103d561f688320d0734a3f071", "ts": 1794481741, "own": false, "body": "I went through the whole release checklist for the preview this morning and everything that touches the timeline, the composer and the sign-in flow behaves the way the web client does, including the wrapping of long lines like this one, which keeps going well past the width of the message column so that it has to break onto a second and a third line before it ends"},
    {"key": "s7", "sender": "20d0ed6103d561f688320d0734a3f071", "ts": 1794481741, "own": false, "body": "the only thing left is the member count in the header"},
