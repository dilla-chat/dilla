[Desktop Entry]
Type=Application
Name=Dilla
GenericName=Chat
Comment=End-to-end encrypted chat, voice and video
Exec=dilla-desktop %U
Icon=chat.dilla.Dilla
Terminal=false
StartupWMClass=chat.dilla.Dilla
Categories=Network;InstantMessaging;Chat;
Keywords=messaging;voice;video;encrypted;
MimeType=x-scheme-handler/dilla;
