[
  {
    "name": "private-result-pending-desktop",
    "mutates": true,
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "prototype": {
      "props": {
        "startAt": "app"
      },
      "steps": [
        {
          "wait": 900
        },
        {
          "type": [
            "main textarea",
            "/remind"
          ]
        },
        {
          "press": "Enter"
        },
        {
          "wait": 300
        },
        {
          "type": [
            "main input[placeholder='in 1 hour']",
            "in 1 hour"
          ]
        },
        {
          "press": "Tab"
        },
        {
          "type": [
            "main input[placeholder='bring two ropes']",
            "bring two ropes"
          ]
        },
        {
          "press": "Enter"
        }
      ]
    },
    "app": {
      "who": "mira",
      "path": "{server}",
      "steps": [
        {
          "type": [
            "main textarea.d-composer__input",
            "/"
          ]
        },
        {
          "waitFor": "textarea[aria-label=\"Command\"]"
        },
        {
          "wait": 8000
        },
        {
          "type": [
            "textarea[aria-label=\"Command\"]",
            "/remind"
          ]
        },
        {
          "press": "Enter"
        },
        {
          "type": [
            "role=combobox[name=\"when\"s]",
            "in 1 hour"
          ]
        },
        {
          "press": "Tab"
        },
        {
          "type": [
            "role=textbox[name=\"text\"s]",
            "bring two ropes"
          ]
        },
        {
          "press": "Enter"
        },
        {
          "waitFor": ".d-bot-result[data-status=\"pending\"]"
        }
      ]
    }
  },
