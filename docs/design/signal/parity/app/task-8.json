[
  {
    "name": "gap44-reply-jump-flash",
    "mutates": true,
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "prototype": {
      "props": {
        "startAt": "app"
      },
      "steps": [
        {
          "wait": 900
        },
        {
          "hover": "article >> nth=0"
        },
        {
          "wait": 300
        },
        {
          "click": "article >> nth=0 >> div[style*='top: -12px'] > span >> nth=1"
        },
        {
          "type": [
            "main textarea",
            "two ropes. final answer."
          ]
        },
        {
          "press": "Enter"
        },
        {
          "wait": 900
        },
        {
          "click": "text=raid tonight at 20:00"
        },
        {
          "wait": 200
        }
      ]
    },
    "app": {
      "who": "ada",
      "path": "{server}",
      "steps": [
        {
          "hover": "role=article >> nth=1"
        },
        {
          "wait": 300
        },
        {
          "click": "role=button[name=/^reply/i] >> nth=0"
        },
        {
          "type": [
            "role=textbox[name=/^message/i]",
            "two ropes. final answer."
          ]
        },
        {
          "press": "Enter"
        },
        {
          "wait": 1500
        },
        {
          "click": "role=button[name=/^Björn.*in\\./]"
        },
        {
          "wait": 200
        }
      ]
    }
  },
