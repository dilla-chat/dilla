  {
    "name": "gap53-code-block-copied",
    "mutates": true,
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "prototype": {
      "props": {
        "startAt": "app"
      },
      "steps": [
        {
          "wait": 900
        },
        {
          "hover": "article:has-text(\"put it in the raid file so nobody argues later:\")"
        },
        {
          "click": "main >> text=Copy >> nth=0"
        },
        {
          "wait": 400
        }
      ]
    },
    "app": {
      "who": "ada",
      "path": "{server}",
      "steps": [
        {
          "click": "role=textbox[name=/^message/i]"
        },
        {
          "type": [
            "role=textbox[name=/^message/i]",
            "put it in the raid file so nobody argues later:\n```yaml\nraid:\n  when: \"2026-10-30T20:00\"\n  where: the bridge\n  bring:\n    - rope      # two, Mira insists\n    - torches\n    - snacks\n  troll: true\n  max_party: 6\n```"
          ]
        },
        {
          "press": "Enter"
        },
        {
          "wait": 2500
        },
        {
          "waitFor": ".d-message-row[data-state=\"ok\"]:has(.d-code-block):has-text(\"put it in the raid file so nobody argues later:\") >> nth=-1"
        },
        {
          "hover": ".d-message-row:has(.d-code-block) >> nth=-1"
        },
        {
          "click": ".d-code-block__copy >> nth=-1"
        },
        {
          "wait": 400
        }
      ]
    },
    "judge": {
      "elements": [
        {
          "id": "search",
          "name": "the search box at the top centre of the window"
        },
        {
          "id": "composer",
          "name": "the message composer at the bottom of the main column"
        },
        {
          "id": "members_heading",
          "name": "the Members heading at the top of the right-hand panel"
        },
        {
          "id": "code_block",
          "name": "the code block with line numbers and a language label in the conversation",
          "data": true
        },
        {
          "id": "copied_button",
          "name": "the button at the top right corner of the code block",
          "copy": "Copied",
          "data": true,
          "state": {
            "unobstructed": {
              "phrase": "fully visible",
              "true": "nothing covers any part of the button",
              "false": "another floating element covers part of the button"
            }
          }
        },
        {
          "id": "check_icon",
          "name": "a check mark inside the button at the top right corner of the code block",
          "compare": [
            "presence"
          ],
          "small": true,
          "region": {
            "x": 870,
            "y": 150,
            "width": 170,
            "height": 560
          }
        },
        {
          "id": "message_toolbar",
          "name": "the small floating toolbar of message action icons at the right of the message with the code block",
          "compare": [
            "presence"
          ]
        }
      ]
    }
  },
